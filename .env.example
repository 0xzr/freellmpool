# freellmpool — API keys for free-tier providers.
#
# Copy this file to `.env` (which is gitignored) and fill in the keys for
# whichever providers you want to use. You do NOT need all of them — freellmpool
# uses whatever you have configured and skips the rest. Many keys below expose
# cardless free tiers. Cerebras currently offers finite trial credit, while
# Vercel can require customer/card verification even for its zero-price route.
#
# freellmpool reads these from the environment. Either `export` them in your
# shell, or use a tool like `direnv` / `python-dotenv`, or pass them inline.
# freellmpool itself does not parse this file — it only reads the environment.

# Groq — https://console.groq.com/keys  (free, very fast)
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai  (finite $5 trial; explicit pins only)
CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (many ':free' models)
OPENROUTER_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey  (generous free tier)
GEMINI_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
# Needs both the token and your account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Mistral — https://console.mistral.ai/api-keys  (free tier)
MISTRAL_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys  (free trial keys)
COHERE_API_KEY=

# SambaNova — https://cloud.sambanova.ai/apis  (free tier)
SAMBANOVA_API_KEY=

# NVIDIA NIM — https://build.nvidia.com  (free credits, huge model catalog)
NVIDIA_API_KEY=

# Z.ai / Zhipu GLM — https://z.ai  (free GLM flash models)
ZHIPU_API_KEY=

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Aion Labs — https://api.aionlabs.ai  (daily no-card free allowance)
AION_API_KEY=

# ModelScope API Inference — https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# Morph — https://www.morphllm.com/dashboard/api-keys
# Cataloged routes are currently priced and disabled; a key alone does not make
# them eligible for automatic routing.
MORPH_API_KEY=

# Vercel AI Gateway — https://vercel.com/ai-gateway
# Hobby includes $5/month. Only Poolside Laguna is currently zero-priced and
# eligible for automatic routing. Priced DeepSeek and Nemotron routes require
# explicit pins; other zero-price candidates remain disabled pending canaries.
# Customer verification/card may be required. Set a monthly key budget and
# disable automatic top-up.
AI_GATEWAY_API_KEY=

# SiliconFlow — https://cloud.siliconflow.cn/account/ak
# Free models require identity verification, but no payment card.
SILICONFLOW_API_KEY=

# ---------------------------------------------------------------------------
# Zero-setup providers (no key needed — included automatically):
#   • Pollinations            (anonymous/keyless)
#   • OVHcloud AI Endpoints  (anonymous/keyless)
#   • Kilo Gateway           (anonymous/keyless)
#   • LLM7                    (works without a key; set LLM7_API_KEY for more)
# With this file empty, freellmpool can answer while at least one enabled
# keyless route is available.
# ---------------------------------------------------------------------------

# LLM7 — optional key for higher limits: https://token.llm7.io
LLM7_API_KEY=

# Optional runtime state override. Recent per-route latency, normalized failure
# class, and circuit reset times otherwise live at:
# ~/.config/freellmpool/route_health.json
FREELLMPOOL_HEALTH_FILE=
